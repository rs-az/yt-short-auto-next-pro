{
  "manifest_version": 3,
  "name": "YouTube Shorts Auto Next Pro",
  "version": "1.0.0",
  "description": "Automatically advances to the next YouTube Short after playback finishes. Features custom delays, smart skip for long videos, random delays, and detailed statistics.",
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Shorts Auto Next Pro"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}